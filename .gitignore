# ---- dependencies ----
node_modules/
.npm/
.pnpm-store/
.yarn/
.pnp.*

# ---- build output (regenerate with `npm run build` / `npm run build:static`) ----
dist/
build/
out/
*.tsbuildinfo
coverage/
.nyc_output/

# ---- runtime data: sqlite db, uploaded media, synced workbooks (never commit real case data) ----
/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.db
# anything an analyst drops in the inbox / media folders when running from the repo directory
/inbox/
/media/

# ---- secrets and local config (only .env.example is tracked) ----
/secrets/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
.npmrc
.docker/config.json

# ---- logs and scratch ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
tmp/
.tmp/
.cache/
*.tmp
*.bak
*.orig

# ---- editors and OS ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ---- browser-test artefacts ----
playwright-report/
test-results/
.playwright/

# ---- Excel lock files created while a workbook is open (the sample workbook itself IS tracked) ----
~$*.xlsx
.~lock.*#

# keep the bundled synthetic sample
!/sample-data/
!/sample-data/**
